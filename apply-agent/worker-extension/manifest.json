{
  "manifest_version": 3,
  "name": "Apply Worker (private)",
  "version": "0.2.0",
  "description": "Drives one of Apply's plain Worker Chromes for Apply on this Mac. Private: never published.",
  "key": "",
  "minimum_chrome_version": "135",
  "background": {"service_worker": "background.js", "type": "module"},
  "permissions": ["nativeMessaging", "tabs", "scripting", "userScripts", "webNavigation", "storage",
                  "declarativeNetRequestWithHostAccess", "webRequest", "system.display"],
  "host_permissions": ["<all_urls>"]
}
