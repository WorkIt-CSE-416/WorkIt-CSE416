# Apply's personal data lives in the data folder ($APPLY_HOME, default
# ~/.config/apply/), never in the repo. These names are ignored in case
# someone puts one in this folder by mistake. Anchored to apply-agent/.
/applicant-profile.yaml
/answer-bank.yaml
/story-bank.md
/voice.md
/policies.yaml
/company-briefs/
/stock-answers.yaml
/story-map.yaml
/rehearsals/
/repairs/
/profiles/
/ship-check/
# The resume and transcript PDFs that the profile's files: names.
/*.pdf
# What Apply writes into the data folder.
/sent/
/tailored/
/traces/
/records/
/apply-records/
/default-probes/
/answer-ledger.jsonl
/workday-trees.json
/sheet-id
/workit-login.*
/tracker.*
/workit-queue.*
/open-forms.*

# The privacy gate's identifier list. It stays outside the repo; this line
# stops a copy in this folder from being committed.
private-identifiers.txt

.venv/
.pytest_cache/
