{
  "name": "workit-repo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "lint:fix": "npm --prefix frontend run lint:fix",
    "typecheck": "npm --prefix frontend run typecheck",
    "format": "npm --prefix frontend run format",
    "format:check": "npm --prefix frontend run format:check",
    "clean": "npm --prefix frontend run clean",
    "db:generate": "npm --prefix frontend run db:generate",
    "db:migrate": "npm --prefix frontend run db:migrate",
    "db:studio": "npm --prefix frontend run db:studio",
    "db:check": "npm --prefix frontend run db:check",
    "scrape": "uv --directory scraper run workit-scrape",
    "scrape:dry": "uv --directory scraper run workit-scrape --dry-run",
    "scraper:lint": "uv --directory scraper run ruff check .",
    "scraper:typecheck": "uv --directory scraper run mypy .",
    "scraper:test": "uv --directory scraper run pytest",
    "favicon": "npm --prefix frontend run favicon",
    "install:frontend": "npm --prefix frontend install",
    "install:scraper": "uv --directory scraper sync"
  }
}
