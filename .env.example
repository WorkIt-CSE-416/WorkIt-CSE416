# 
DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# ALEMBIC'S CONNECTION — session pooler, port 5432.
# DDL takes locks and needs one serial conversation with the database. Running
# migrations through the transaction pooler above is unreliable.
#
# THE PORT IS THE ONLY DIFFERENCE between these two lines, and getting it wrong
# produces intermittent failures rather than an obvious error. Check it twice.
DIRECT_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

