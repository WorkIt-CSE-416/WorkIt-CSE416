# transaction pooler 
DATABASE_URL=postgresql://postgres.your-project-ref:[password]@aws-0-region.pooler.supabase.com:6543/postgres

# Session pooler for alembic
DIRECT_URL=postgresql://postgres.your-project-ref:[password]@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase Storage (file uploads) and Auth (signup, token verification).
# The service-role key stays in this file only — never in frontend/.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Scout, the job assistant, on Groq (the production model). Get a key at
# console.groq.com/keys. With all three unset Scout uses a local Ollama, and
# .superset/setup.sh warns. Other endpoints: scout/CLAUDE.md.
SCOUT_BASE_URL=https://api.groq.com/openai/v1
SCOUT_MODEL=openai/gpt-oss-120b
SCOUT_API_KEY=
# gpt-oss takes low, medium or high; the unset default, none, is Ollama's.
SCOUT_REASONING_EFFORT=low
# SCOUT_FALLBACK_BASE_URL=
# SCOUT_FALLBACK_MODEL=
# SCOUT_FALLBACK_API_KEY=
# SCOUT_FALLBACK_REASONING_EFFORT=
# SCOUT_DAILY_TURNS=50

# Embeddings use Ollama with nomic-embed-text:v1.5 (768 dimensions).
# See backend/docs/local-embeddings.md. Scout uses independent model settings.
# OLLAMA_EMBEDDING_URL=http://localhost:11434
# EMBEDDING_TIMEOUT_SECONDS=120

# Shared test applicant (test data only) for testing pages behind sign-in.
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=
