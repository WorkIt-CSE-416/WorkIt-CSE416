# transaction pooler 
DATABASE_URL=postgresql://postgres.your-project-ref:[password]@aws-0-region.pooler.supabase.com:6543/postgres

# Session pooler for alembic
DIRECT_URL=postgresql://postgres.your-project-ref:[password]@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase Storage (file uploads) and Auth (signup, token verification).
# The service-role key stays in this file only — never in frontend/.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Scout, the job assistant, on Groq (the production model). Get a key at
# console.groq.com/keys. With all three unset Scout uses a local Ollama, and
# .superset/setup.sh warns. Other endpoints: scout/CLAUDE.md.
SCOUT_BASE_URL=https://api.groq.com/openai/v1
SCOUT_MODEL=openai/gpt-oss-120b
SCOUT_API_KEY=
# gpt-oss takes low, medium or high; the unset default, none, is Ollama's.
SCOUT_REASONING_EFFORT=low
# The endpoint chain, tried in order; overrides the four above when set.
# SCOUT_ENDPOINTS=[{"base_url": "https://api.groq.com/openai/v1", "model": "openai/gpt-oss-120b", "api_key": "..."}]
# A chain per model size (KAN-356), same format, each one line. The default
# chain above follows each, so write a shared fallback (Gemini) there once.
# Unset, a size uses the default chain alone. Large: Tailor, Read It With AI,
# the editor assistant. Small: every keyword extraction. Restart the API after
# a change: the models are built once.
# SCOUT_ENDPOINTS_LARGE=[{"base_url": "https://api.groq.com/openai/v1", "model": "openai/gpt-oss-120b", "api_key": "..."}]
# SCOUT_ENDPOINTS_SMALL=[{"base_url": "https://api.groq.com/openai/v1", "model": "openai/gpt-oss-20b", "api_key": "...", "reasoning_effort": "low"}]

# Daily AI uses (backend/app/config.py). Defaults are the spec's numbers:
# caps per student per UTC day, and each feature's share of the daily pool.
# AI_DAILY_POOL=1000
# AI_SCOUT_CAP=3
# AI_INTAKE_CAP=15
# AI_TAILOR_CAP=2
# AI_PARSING_CAP=1
# AI_ASSISTANT_CAP=10
# AI_TAILOR_SHARE=0.4
# AI_INTAKE_SHARE=0.3
# AI_SCOUT_SHARE=0.2
# AI_PARSING_SHARE=0.1
# AI_ASSISTANT_SHARE=0.1

# Embeddings use Ollama with nomic-embed-text:v1.5 (768 dimensions).
# See backend/docs/local-embeddings.md. Scout uses independent model settings.
# OLLAMA_EMBEDDING_URL=http://localhost:11434
# EMBEDDING_TIMEOUT_SECONDS=120

# Cloudflare Turnstile secret key for bot protection on signup and sign-in.
# Leave empty to skip verification in local dev.
TURNSTILE_SECRET_KEY=

# Shared test applicant (test data only) for testing pages behind sign-in.
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=
