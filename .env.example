# transaction pooler 
DATABASE_URL=postgresql://postgres.your-project-ref:[password]@aws-0-region.pooler.supabase.com:6543/postgres

# Session pooler for alembic
DIRECT_URL=postgresql://postgres.your-project-ref:[password]@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase Storage (file uploads) and Auth (signup, token verification).
# The service-role key stays in this file only — never in frontend/.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key


# The Python API. Server-side only, deliberately not NEXT_PUBLIC_*.
API_URL=http://localhost:8000

# Supabase Auth keys 
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

