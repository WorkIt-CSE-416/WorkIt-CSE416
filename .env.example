# transaction pooler 
DATABASE_URL=postgresql://postgres.your-project-ref:[password]@aws-0-region.pooler.supabase.com:6543/postgres

# Session pooler for alembic
DIRECT_URL=postgresql://postgres.your-project-ref:[password]@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase project URL + service-role key. Both signup and every token
# verification (password or OAuth) need these — get_supabase() and
# decode_access_token() both raise without them.
#
# To fill these in yourself:
#   1. Supabase Dashboard -> this project -> Project Settings (gear icon,
#      bottom of the left sidebar) -> API Keys.
#   2. SUPABASE_URL is the "Project URL" at the top of that page.
#   3. SUPABASE_SERVICE_KEY is the "service_role" key further down —
#      labeled "secret". NOT the "anon" / "public" key; that one's
#      frontend/.env.local's NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
#
# service_role bypasses every database security rule (RLS included), so:
#   - it goes ONLY in this file's real copy (.env, gitignored), never in
#     frontend/ (a NEXT_PUBLIC_ prefix there would ship it to every browser)
#   - never paste it in Slack/Discord/a PR/anywhere outside your local .env
#     — if it ever leaks, rotate it from the same API Keys page
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key


