# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies. Unanchored on purpose: these live inside each workspace folder
# (frontend/node_modules, backend/.venv), not at the repo root, so a leading
# slash would match nothing.
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python virtualenvs and bytecode. Same reasoning as node_modules above: these
# live inside backend/, not at the repo root, so no leading slash.
.venv/
venv/
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/

# testing
coverage/

# next.js
.next/
out/

# production
build/

# python
__pycache__/
*.py[cod]
.venv/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must be committed, or a fresh clone has nothing to copy.
# `.env.example` at the root is that template, and `.env` beside it is what the
# backend reads (see backend/CLAUDE.md). Without this negation the rule above
# would swallow the template silently.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]

# claude skill reports
claudeskill_reports/

# Agent-generated design specs and implementation plans: local scratch, not
# project documentation. frontend/docs/backend-integration.md and
# frontend/docs/shadcn.md are the real docs.
docs/superpowers/
