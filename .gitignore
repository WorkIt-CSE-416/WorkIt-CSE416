# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies. Unanchored on purpose: these live inside each workspace folder
# (frontend/node_modules, and backend/ when it lands), not at the repo root, so
# a leading slash would match nothing.
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude skill reports
claudeskill_reports/
