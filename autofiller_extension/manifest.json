{
  "manifest_version": 3,
  "name": "WorkIt Autofiller (Prototype)",
  "version": "0.1.0",
  "key": "",
  "description": "Fills job applications from your WorkIt profile and resume. Prototype — user-triggered only, never submits on your behalf.",
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": "icons/icon.png",
    "default_title": "WorkIt Autofiller"
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting", "cookies"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://workit-api.vercel.app/*",
    "http://localhost:3000/*",
    "https://workit-web-gamma.vercel.app/*",
    "https://*.greenhouse.io/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://workit-web-gamma.vercel.app/*"
    ]
  }
}
