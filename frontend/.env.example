# Supabase project settings → API
#
# Needed only once something reads a real session; every screen renders the
# fixture data in its data.ts without them. Both are NEXT_PUBLIC_ on purpose:
# the anon key is designed to ship to the browser.
#
# Whether the app uses Supabase Auth at all is still an open decision — see
# docs/backend-integration.md before building on these.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# No Postgres connection string and no service-role key belongs in this file,
# under any circumstances. The frontend opens no database connection; those
# credentials belong to the Python service's environment, where a mis-prefixed
# variable cannot end up in the client bundle.
