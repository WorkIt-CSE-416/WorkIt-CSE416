# The Python API. Server-side only, deliberately not NEXT_PUBLIC_*.
API_URL=http://localhost:8000

# Supabase Auth keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Add to Claude (KAN-383, src/lib/claude-connector.ts). Server-side only.
# The API's address as its connector OAuth metadata names it, when it isn't
# API_URL (same value as the backend's CONNECTOR_API_URL):
# CONNECTOR_API_URL=https://api.workitjobs.ai
# Once Anthropic lists WorkIt in its connector directory, the listing page:
# CLAUDE_CONNECTOR_LINK=https://claude.ai/directory/connectors/<slug>

# Brandfetch's client ID for company logos (KAN-442, src/lib/job-logo.ts).
# Public by design: every logo URL carries it. Leave empty to show only the
# logos the scraper found.
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=

# Cloudflare Turnstile site key for bot protection on signup and sign-in.
# Leave empty to hide the widget in local dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key for server-side verification of sign-in.
# Leave empty to skip verification in local dev.
TURNSTILE_SECRET_KEY=
