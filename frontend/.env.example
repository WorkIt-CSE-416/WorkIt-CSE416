# Supabase project settings → API
#
# These are the only variables the Next.js app needs. Both are NEXT_PUBLIC_ on
# purpose: the anon key is meant to be shipped to the browser, and row-level
# security — not secrecy — is what protects the data behind it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# No Postgres connection string lives here. The frontend does not open a
# database connection: it reads the session from Supabase and will call the
# Python API for everything else. Connection strings and service-role keys
# belong to that service's own environment, never to a Next.js app where a
# mis-prefixed variable ends up in the client bundle. See docs/supabase.md.
